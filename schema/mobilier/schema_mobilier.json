  "fields": [
    {
      "name": "id_mobilier",
      "title": "identifiant du mobilier",
      "description": "identifiant unique du mobilier",
      "example": "44003:MOB:0098:LOC",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "type_mobilier",
      "title": "type de mobilier",
      "description": "type de mobilier",
      "example": "table avec banc pour PMR",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "assise",
          "assise pour PMR ",
          "table avec banc intégré",
          "table avec banc pour PMR",
          "abri",
          "belvédère ou plateforme d’observation",
          "agrès sensoriels",
          "agrès sportif",
          "fontaine à eau",
          "poubelle",
          "barbecue",
          "support vélo",
          "autre",
          "NC",
          "sans objet"
        ]
      }
    },
    {
      "name": "geom_pct",
      "title": "géométrie ponctuelle du mobilier",
      "description": "géométrie ponctuelle du mobilier en projection Lambert93 au format GeoJSON",
      "example": "{\"type\": \"Point\", \"coordinates\": [ [656589.70, 6425785.32] }",
      "type": "geojson",
      "constraints": {
        "required": true
      }
    }
  ],
  "missingValues": [
    "",
    "NA",
    "NaN",
    "N/A"
  ],
  "primaryKey": "id_mobilier"
}